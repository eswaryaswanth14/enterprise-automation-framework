<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Automation Suite"
       parallel="tests"
       thread-count="2">

    <listeners>
        <listener class-name="com.enterprise.automation.listeners.TestListener"/>
    </listeners>

    <test name="Group Tests">
        <classes>
            <class name="com.enterprise.automation.groups.GroupTest"/>
        </classes>
    </test>

    <test name="Login Automation Tests">
        <classes>
            <class name="com.enterprise.automation.tests.LoginTest"/>
        </classes>
    </test>

</suite>
